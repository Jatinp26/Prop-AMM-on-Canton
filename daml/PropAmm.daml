module PropAmm where
import DA.Time (assertWithinDeadline)

data HoldingSplitResult = HoldingSplitResult
  with
    transferred : ContractId Holding
    remainder   : Optional (ContractId Holding)
  deriving (Eq, Show)

data SwapResult = SwapResult
  with
    delivered   : ContractId Holding          -- what the taker received
    paid        : ContractId Holding          -- what the admin received
    takerChange : Optional (ContractId Holding)
  deriving (Eq, Show)

data MintResult = MintResult
  with
    slot             : ContractId LiquiditySlot
    offerHoldingCid  : ContractId Holding
    reserveRemainder : Optional (ContractId Holding)
  deriving (Eq, Show)

template Holding
  with
    registrar : Party
    owner     : Party
    symbol    : Text
    amount    : Decimal
  where
    signatory registrar
    observer  owner
    ensure amount > 0.0

    choice Holding_SplitTransfer : HoldingSplitResult
      with
        newOwner       : Party
        transferAmount : Decimal
      controller owner
      do
        assertMsg "transferAmount must be positive" (transferAmount > 0.0)
        assertMsg "insufficient holding amount" (transferAmount <= amount)
        transferred <- create this with owner = newOwner, amount = transferAmount
        remainder <-
          if amount > transferAmount
            then do
              cid <- create this with amount = amount - transferAmount
              pure (Some cid)
            else pure None
        pure HoldingSplitResult with transferred; remainder

template TraderEntitlement
  with
    admin               : Party
    trader              : Party
    poolId              : Text
    maxNotionalPerSwap  : Decimal
    expiresAt           : Time
  where
    signatory admin
    observer  trader
    ensure maxNotionalPerSwap > 0.0

    choice TraderEntitlement_Revoke : ()
      controller admin
      do return ()

template PoolConfig
  with
    admin      : Party
    poolId     : Text
    baseSymbol : Text
    quoteSymbol: Text
    feeBps     : Int
  where
    signatory admin
    ensure feeBps >= 0

template PoolRules
  with
    admin  : Party
    poolId : Text
  where
    signatory admin

    nonconsuming choice PoolRules_MintSlot : MintResult
      with
        slotId            : Text
        reserveHoldingCid : ContractId Holding  -- admin's main reserve
        offerAmount       : Decimal             -- exact size of this slot
        wantSymbol        : Text                -- what the taker pays in
        price             : Decimal             -- wantSymbol units per offerSymbol unit
        expiresAt         : Time
        reservedFor       : Optional Party      -- None = any entitled trader
      controller admin
      do
        assertMsg "offerAmount must be positive" (offerAmount > 0.0)
        assertMsg "price must be positive" (price > 0.0)
        reserve <- fetch reserveHoldingCid
        assertMsg "reserve not owned by admin" (reserve.owner == admin)

        split <- exercise reserveHoldingCid Holding_SplitTransfer with
          newOwner = admin
          transferAmount = offerAmount

        slot <- create LiquiditySlot with
          admin
          poolId
          slotId
          reservedFor
          offerHoldingCid = split.transferred
          offerRegistrar  = reserve.registrar
          offerSymbol     = reserve.symbol
          offerAmount
          wantSymbol
          price
          expiresAt

        pure MintResult with
          slot
          offerHoldingCid  = split.transferred
          reserveRemainder = split.remainder

template LiquiditySlot
  with
    admin           : Party
    poolId          : Text
    slotId          : Text
    reservedFor     : Optional Party
    offerHoldingCid : ContractId Holding
    offerRegistrar  : Party
    offerSymbol     : Text
    offerAmount     : Decimal
    wantSymbol      : Text
    price           : Decimal
    expiresAt       : Time
  where
    signatory admin
    ensure offerAmount > 0.0 && price > 0.0 && offerSymbol /= wantSymbol

    choice LiquiditySlot_Swap : SwapResult
      with
        taker          : Party
        entitlementCid : ContractId TraderEntitlement
        payHoldingCid  : ContractId Holding
        maxPay         : Decimal   -- taker's protection against a stale quote
      controller taker
      do
        assertWithinDeadline "slot" expiresAt

        entitlement <- fetch entitlementCid
        assertMsg "entitlement not issued by this admin" (entitlement.admin == admin)
        assertMsg "entitlement is for a different pool" (entitlement.poolId == poolId)
        assertMsg "entitlement does not belong to taker" (entitlement.trader == taker)
        assertWithinDeadline "entitlement" entitlement.expiresAt

        case reservedFor of
          Some t  -> assertMsg "slot is reserved for another trader" (t == taker)
          None    -> pure ()

        let payAmount = offerAmount * price
        assertMsg "quote worse than taker's limit" (payAmount <= maxPay)
        assertMsg "exceeds per-swap notional cap"
          (payAmount <= entitlement.maxNotionalPerSwap)

        payHolding <- fetch payHoldingCid
        assertMsg "payment holding not owned by taker" (payHolding.owner == taker)
        assertMsg "wrong payment instrument" (payHolding.symbol == wantSymbol)

        offerHolding <- fetch offerHoldingCid
        assertMsg "slot backing has been tampered with"
          (offerHolding.owner == admin
             && offerHolding.symbol == offerSymbol
             && offerHolding.amount == offerAmount)

        payment <- exercise payHoldingCid Holding_SplitTransfer with
          newOwner = admin
          transferAmount = payAmount

        delivery <- exercise offerHoldingCid Holding_SplitTransfer with
          newOwner = taker
          transferAmount = offerAmount

        pure SwapResult with
          delivered   = delivery.transferred
          paid        = payment.transferred
          takerChange = payment.remainder

    choice LiquiditySlot_Cancel : ContractId Holding
      controller admin
      do pure offerHoldingCid
